# Copy to .env (`python tasks.py setup` does this for you) and change the password.
# .env is gitignored; this file is not.

# Postgres credentials. docker compose AND the pipeline both read these,
# so the password is written exactly once.
POSTGRES_USER=col_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=col_platform
POSTGRES_PORT=5433

# Optional: set DB_URL to override the above entirely (CI and cloud deployments do this).
# DB_URL=postgresql+psycopg2://user:password@host:5432/dbname

# Optional: an API token raises the data.gov.my rate limit from 4 to 10 requests/minute
DATAGOVMY_API_TOKEN=

# How far behind the watermark to re-fetch, to catch revised prices
LOOKBACK_DAYS=21
LOG_LEVEL=INFO
