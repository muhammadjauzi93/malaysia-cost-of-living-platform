# secrets
.env

# environments & tooling
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# data never goes in Git; keep the folder, ignore the contents
data/*
!data/landing/
data/landing/*
!data/landing/.gitkeep

# Dagster writes its run history and schedule state here; only dagster.yaml is committed
dagster_home/*
!dagster_home/dagster.yaml

# Responses saved by `probe-bnm`
data/probe/
